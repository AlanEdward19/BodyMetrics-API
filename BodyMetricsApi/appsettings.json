{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "bodymetrics"
  },
  "AthletePhotoStorage": {
    "Provider": "AzureBlob",
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "athlete-photos",
    "ReadUrlExpirationMinutes": 60
  },
  "AllowedHosts": "*"
}
